        <mxCell id="LskhNOTcGIdwXDDMSMeO-54" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;metodi generici&lt;/font&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;background-color: initial; font-size: 14px;&quot;&gt;SaveManager.gd&lt;/font&gt;&lt;font style=&quot;font-size: 12px; background-color: initial;&quot;&gt;.&lt;/font&gt;&lt;span style=&quot;font-size: 12px; background-color: initial;&quot;&gt;_save_global_status()&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;metodo che si occupa di salvare tutte le informazioni di gioco comunicando con ChacheManager&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;dashed=1;perimeterSpacing=2;strokeColor=default;align=left;" vertex="1" parent="1">
          <mxGeometry x="10" y="-1110" width="290" height="300" as="geometry" />
        </mxCell>
        <mxCell id="LskhNOTcGIdwXDDMSMeO-55" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;singleton responsabili&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;u&gt;SaveManager&lt;/u&gt;&lt;br&gt;si occupa di salvare lo status di defoult contattando il &lt;b&gt;ChacheManager&lt;/b&gt; e chiedendo uno status generico completo&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;u&gt;LoadManager&lt;/u&gt;&lt;br&gt;si occupa di caricare la partita partendo dalla stanza e dalla posizione del player nella scena&amp;nbsp;&lt;br&gt;&lt;b&gt;RoomSystem &lt;/b&gt;che viene esteso datutti i livelli del gioco si occupera di popolare &lt;b&gt;ChacheManager&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&quot;font-weight: bold;&quot;&gt;ChacheManager&lt;br&gt;&lt;/b&gt;si occupa di gestire gli elementi vivi durante la scena permettendo un salvataggio mirato, viene popolato quando viene attivato un livello&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="10" y="-800" width="180" height="460" as="geometry" />
        </mxCell>
