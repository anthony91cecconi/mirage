; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="mirage"
config/version="0.0.1"
run/main_scene="res://scenes/core/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

D="*res://scripts/utility/Debugger.gd"
SaveManager="*res://scripts/memory/SaveManager.gd"
LoadManager="*res://scripts/memory/LoadManager.gd"
SaveFinalRecorder="*res://scripts/memory/SaveFinalRecorder.gd"
PlayerManager="*res://scripts/menagers/PlayerManager.gd"
HumansManager="*res://scripts/menagers/HumansManager.gd"
TimeManager="*res://scripts/menagers/TimeManager.gd"
RoomManager="*res://scripts/menagers/RoomManager.gd"
CameraMenager="*res://scripts/menagers/CameraMenager.gd"
TouchControls="*res://android/controls/touch_controls.tscn"
JobManager="*res://scripts/menagers/JobManager.gd"
Orchestrator="*res://scripts/menagers/Orchestrator.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

entities="tutte le entita con cui il player puo interagire"
player=""
bed=""
npc=""
humans=""
doors=""
navigation=""
job=""

